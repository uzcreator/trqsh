    "ngrok-alternative",
    "quic",
    "http3",
    "reverse-proxy",
    "webhook"
  ],
  "homepage": "https://trqsh.uz",
  "bugs": "https://github.com/trqsh/trqsh/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/trqsh/trqsh.git",
