# Copy to deploy/.env and adjust. docker compose auto-loads it.
# These override the dev defaults baked into docker-compose.dev.yml.
# For localhost only — generate real secrets for staging/prod (see terraform).

# Shared edge <-> API token (must match on both).
TRQSH_INTERNAL_TOKEN=dev-internal-token

# API session signing key.
TRQSH_JWT_SECRET=dev-jwt-secret-change-me

# --- Billing (optional; Stripe test mode). Leave blank to disable billing. ---
TRQSH_STRIPE_SECRET_KEY=
TRQSH_STRIPE_WEBHOOK_SECRET=
TRQSH_STRIPE_PRICE_PRO_MONTHLY=
TRQSH_STRIPE_PRICE_PRO_ANNUAL=
TRQSH_STRIPE_PRICE_TEAM_MONTHLY=
TRQSH_STRIPE_PRICE_TEAM_ANNUAL=
TRQSH_STRIPE_PRICE_PAYG_METERED=
TRQSH_STRIPE_METER_BANDWIDTH=
TRQSH_STRIPE_METER_REQUESTS=

# --- OAuth (optional). Dev auth (TRQSH_DEV_AUTH=1) is on by default in compose. ---
TRQSH_GITHUB_CLIENT_ID=
TRQSH_GITHUB_CLIENT_SECRET=
TRQSH_GOOGLE_CLIENT_ID=
TRQSH_GOOGLE_CLIENT_SECRET=
