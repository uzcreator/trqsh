# Copy to deploy/.env and adjust. docker compose auto-loads it.
# These override the dev defaults baked into docker-compose.dev.yml.
# For localhost only — generate real secrets for staging/prod (see terraform).

# Shared edge <-> API token (must match on both).
RIFT_INTERNAL_TOKEN=dev-internal-token

# API session signing key.
RIFT_JWT_SECRET=dev-jwt-secret-change-me

# --- Billing (optional; Stripe test mode). Leave blank to disable billing. ---
RIFT_STRIPE_SECRET_KEY=
RIFT_STRIPE_WEBHOOK_SECRET=
RIFT_STRIPE_PRICE_PRO_MONTHLY=
RIFT_STRIPE_PRICE_PRO_ANNUAL=
RIFT_STRIPE_PRICE_TEAM_MONTHLY=
RIFT_STRIPE_PRICE_TEAM_ANNUAL=
RIFT_STRIPE_PRICE_PAYG_METERED=
RIFT_STRIPE_METER_BANDWIDTH=
RIFT_STRIPE_METER_REQUESTS=

# --- OAuth (optional). Dev auth (RIFT_DEV_AUTH=1) is on by default in compose. ---
RIFT_GITHUB_CLIENT_ID=
RIFT_GITHUB_CLIENT_SECRET=
RIFT_GOOGLE_CLIENT_ID=
RIFT_GOOGLE_CLIENT_SECRET=
