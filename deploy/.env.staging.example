# STAGING environment for docker-compose.prod.yml.
# Copy to deploy/.env on the STAGING host and fill in.  NEVER commit deploy/.env.
#
# Staging mirrors production but keeps TLS on Let's Encrypt STAGING (untrusted certs,
# no rate limits) so you can prove cert issuance and — importantly — exercise the
# riskier Stage C/D changes (shared Redis cert storage + cross-edge forwarding)
# against a real server BEFORE cutting them over in production. Use a SEPARATE domain
# or subdomain and SEPARATE secrets from prod.
#
# Generate strong random values with:   openssl rand -hex 32

# --- Required secrets -------------------------------------------------------

# Postgres password (any strong random string). Do NOT reuse the prod value.
POSTGRES_PASSWORD=

# API session signing key. MUST be >= 32 characters, strong & random.
TRQSH_JWT_SECRET=

# Shared edge <-> API token. Strong & random. Fed to both the edge and the API.
TRQSH_INTERNAL_TOKEN=

# Email for Let's Encrypt (expiry notices / recovery). Use a real inbox.
TRQSH_ACME_EMAIL=otashdev1@gmail.com

# --- Domain -----------------------------------------------------------------
# Point a staging domain/subdomain's wildcard at this host (e.g. *.staging.trqsh.uz).

TRQSH_BASE_DOMAIN=staging.trqsh.uz
TRQSH_REGION=eu
TRQSH_EDGE_ID=edge-staging-1

# --- Images -----------------------------------------------------------------
# Pin the tag under test. Staging is where you validate a build before prod: point
# it at a specific sha-xxxxxxx (or `main`) rather than `latest`.
TRQSH_IMAGE_TAG=main

# --- TLS mode ---------------------------------------------------------------
# 1 = Let's Encrypt STAGING (untrusted certs, no rate limits). Staging stays here.
TRQSH_ACME_STAGING=1

# --- TLS strategy -----------------------------------------------------------
# Optional Cloudflare DNS-01 token for a *.staging wildcard cert. Leave BLANK to use
# on-demand per-subdomain TLS-ALPN certs (works with any DNS provider).
TRQSH_CLOUDFLARE_API_TOKEN=

# --- Scaling the control API (optional) -------------------------------------
# Staging is the right place to rehearse api scale-out (`--scale api=N` + apilb
# profile). Set to `apilb` when you do; leave `api` otherwise.
TRQSH_API_TARGET=api

# --- Observability (optional; only used with --profile observability) -------
GRAFANA_ADMIN_PASSWORD=admin

# --- OAuth (optional; needed for public web sign-up) ------------------------
# Use SEPARATE staging OAuth apps (their callback URLs must point at the staging
# api host), or leave blank and use API keys for staging tunnels.
TRQSH_GITHUB_CLIENT_ID=
TRQSH_GITHUB_CLIENT_SECRET=
TRQSH_GOOGLE_CLIENT_ID=
TRQSH_GOOGLE_CLIENT_SECRET=
