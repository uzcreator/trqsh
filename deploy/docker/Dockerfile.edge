# trqsh edge server (trqshd). Build context = repo root:
#   docker build -f deploy/docker/Dockerfile.edge -t trqsh/edge .
#
# Static, CGO-free (quic-go is pure Go), shipped on distroless/static:nonroot.
# The edge terminates public HTTP/HTTPS (:80/:443) and accepts agent sessions
# over QUIC (:4443/udp) + TCP fallback (:4443/tcp); metrics/health on :9090.

# --- build ---
FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
WORKDIR /src

# Cache modules first.
COPY go.mod go.sum ./
RUN go mod download

# Then the source.
COPY . .

ARG VERSION=dev
RUN go build -ldflags "-s -w -X main.version=${VERSION}" -o /out/trqshd ./cmd/trqshd

# --- runtime ---
FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/trqshd /usr/local/bin/trqshd

# HTTP, HTTPS, QUIC/agent (udp+tcp), metrics+health.
EXPOSE 80/tcp 443/tcp 4443/tcp 4443/udp 9090/tcp

USER nonroot:nonroot
# distroless has no shell/curl; the binary checks its own /healthz on the metrics port (see cmd/trqshd/main.go).
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/trqshd", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/trqshd"]
