# trqsh web dashboard (Next.js 15 App Router). Build context = repo root:
#   docker build -f deploy/docker/Dockerfile.dashboard -t trqsh/dashboard .
#
# Server Components + Server Actions require a Node runtime (not a static
# export). TRQSH_API_URL points the server-side data layer at the control API.
# Uses pnpm 9 (runs dependency build scripts like sharp; pnpm 10 ignores them).

# --- deps ---
FROM node:24-alpine AS deps
RUN npm install -g pnpm@9
WORKDIR /app
COPY web/dashboard/package.json web/dashboard/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# --- build ---
FROM node:24-alpine AS build
RUN npm install -g pnpm@9
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/dashboard/ ./
# Drop the pnpm-workspace.yaml artifact (pnpm 10 wrote it to record sharp as an
# ignored build). With pnpm 9 it makes pnpm treat this as a workspace and fail
# with "packages field missing"; pnpm 9 builds sharp normally without it.
RUN rm -f pnpm-workspace.yaml
# Inlined at build (next.config env): the API base the browser hits for OAuth,
# and the public base domain shown in the UI.
ARG TRQSH_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_TRQSH_BASE_DOMAIN=lvh.me
ENV NEXT_TELEMETRY_DISABLED=1 \
    TRQSH_API_URL=$TRQSH_API_URL \
    NEXT_PUBLIC_TRQSH_BASE_DOMAIN=$NEXT_PUBLIC_TRQSH_BASE_DOMAIN
RUN pnpm build

# --- runtime ---
FROM node:24-alpine AS runtime
RUN npm install -g pnpm@9 && addgroup -S nodejs && adduser -S nextjs -G nodejs
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
COPY --from=build /app/package.json /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.mjs ./next.config.mjs
USER nextjs
EXPOSE 3000/tcp
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:3000/login || exit 1
CMD ["pnpm", "start"]
