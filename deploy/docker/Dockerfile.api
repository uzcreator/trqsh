# trqsh control API (trqshapi). Build context = repo root:
#   docker build -f deploy/docker/Dockerfile.api -t trqsh/api .
#
# Accounts, API keys, domains, quotas, entitlements RPC, and billing webhooks.
# Static, CGO-free, distroless/static:nonroot. Listens on :8080 (/healthz).

# --- build ---
FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=dev
RUN go build -ldflags "-s -w -X main.version=${VERSION}" -o /out/trqshapi ./cmd/trqshapi

# --- runtime ---
FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/trqshapi /usr/local/bin/trqshapi

EXPOSE 8080/tcp
USER nonroot:nonroot
# distroless has no shell/curl; the binary checks its own /healthz (see cmd/trqshapi/main.go).
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/trqshapi", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/trqshapi"]
