# Production secrets for docker-compose.prod.yml.
# Copy to deploy/.env and fill in.  NEVER commit deploy/.env (it is gitignored).
#
# Generate strong random values with:   openssl rand -hex 32

# --- Required secrets -------------------------------------------------------

# Postgres password (any strong random string).
POSTGRES_PASSWORD=

# API session signing key. MUST be >= 32 characters, strong & random.
TRQSH_JWT_SECRET=

# Shared edge <-> API token. Strong & random. The compose file feeds the SAME
# value to both the edge and the API, so just set it once here.
TRQSH_INTERNAL_TOKEN=

# Email for Let's Encrypt (expiry notices / recovery). Use a real inbox.
TRQSH_ACME_EMAIL=otashdev1@gmail.com

# --- Domain -----------------------------------------------------------------

TRQSH_BASE_DOMAIN=trqsh.uz
TRQSH_REGION=eu
TRQSH_EDGE_ID=edge-1

# --- TLS mode ---------------------------------------------------------------
# 1 = Let's Encrypt STAGING  — test issuance, certs are UNTRUSTED (browser
#     warning) but there are no rate limits. Use this FIRST to prove the flow.
# 0 = Let's Encrypt PRODUCTION — real, browser-trusted certs. Switch to 0 only
#     after staging succeeded, then: docker compose ... up -d --force-recreate edge
TRQSH_ACME_STAGING=1

# --- TLS strategy -----------------------------------------------------------
# OPTIONAL. A Cloudflare API token (permission: Zone.DNS = Edit, scoped to the
# trqsh.uz zone) lets the edge obtain ONE wildcard cert for *.trqsh.uz via
# DNS-01. Requires the domain's DNS to be hosted at Cloudflare.
#
# Leave BLANK to use automatic on-demand per-subdomain certs (TLS-ALPN) instead
# — that works with ANY DNS provider, as long as *.trqsh.uz points at this
# server and port 443 is reachable.
TRQSH_CLOUDFLARE_API_TOKEN=

# --- OAuth (optional; needed for public web sign-up) ------------------------
# In production the password-less dev auth is OFF, so real users sign in via
# OAuth. Fill these when you set up the GitHub/Google apps (can be added later).
TRQSH_GITHUB_CLIENT_ID=
TRQSH_GITHUB_CLIENT_SECRET=
TRQSH_GOOGLE_CLIENT_ID=
TRQSH_GOOGLE_CLIENT_SECRET=
