# =============================================================================
#  trqsh production configuration — ONE file drives the whole deploy.
# =============================================================================
# Copy this to deploy/.env and fill it in. docker-compose.prod.yml loads the
# whole file into the control API (env_file), so enabling any feature — OAuth,
# the admin console, Stripe billing, geo/location — is a `.env` edit + restart.
# You never open the compose file or the code to add a secret.
#
#   cp .env.prod.example .env && nano .env
#   docker compose -f docker-compose.prod.yml pull
#   docker compose -f docker-compose.prod.yml up -d
#
# deploy/.env is gitignored — NEVER commit it. Generate strong secrets with:
#   openssl rand -hex 32
# =============================================================================


# --- REQUIRED ----------------------------------------------------------------

# Postgres password (any strong random string).
POSTGRES_PASSWORD=

# API session signing key. MUST be >= 32 characters, strong & random.
TRQSH_JWT_SECRET=

# Shared edge <-> API token. Strong & random. The compose file feeds the SAME
# value to both the edge and the API, so just set it once here.
TRQSH_INTERNAL_TOKEN=

# Email for Let's Encrypt (cert expiry notices / recovery). Use a real inbox.
TRQSH_ACME_EMAIL=otashdev1@gmail.com

# Your public base domain. A wildcard *.<domain> must point at this host.
TRQSH_BASE_DOMAIN=trqsh.uz


# --- ADMIN CONSOLE (approve.<domain>) ----------------------------------------
# Enables the admin dashboard (fleet stats, users, orgs, tunnels) + subscription
# grant/revoke. BOTH must be set; leave empty to disable the admin surface.
TRQSH_ADMIN_USER=
TRQSH_ADMIN_PASSWORD=


# --- EDGE / REGION -----------------------------------------------------------
TRQSH_REGION=eu
TRQSH_EDGE_ID=edge-1


# --- TLS ---------------------------------------------------------------------
# 1 = Let's Encrypt STAGING — test issuance, certs UNTRUSTED (browser warning)
#     but no rate limits. Use this FIRST to prove the flow.
# 0 = Let's Encrypt PRODUCTION — real, browser-trusted certs. Switch to 0 only
#     after staging succeeded, then:
#       docker compose -f docker-compose.prod.yml up -d --force-recreate edge
TRQSH_ACME_STAGING=1

# OPTIONAL Cloudflare API token (Zone.DNS:Edit, scoped to your zone) for ONE
# wildcard *.<domain> cert via DNS-01. Blank = automatic on-demand per-subdomain
# certs (TLS-ALPN) — works with ANY DNS provider as long as *.<domain> points
# here and 443 is reachable.
TRQSH_CLOUDFLARE_API_TOKEN=


# --- LOCATION / GEO (optional) -----------------------------------------------
# Country detection powers /v1/geo nearest-region routing and the country data in
# tunnel history + the admin dashboard. Pick ONE source:
#   * Behind Cloudflare — trust the country header it injects:
#       TRQSH_GEOIP_HEADER=CF-IPCountry
#   * Direct (no CDN) — call an external GeoIP JSON provider ({ip} placeholder):
#       TRQSH_GEOIP_API=http://ip-api.com/json/{ip}?fields=status,countryCode,country,regionName,city,lat,lon
# Leave both blank to disable detection (regions are still served from the catalog).
TRQSH_GEOIP_HEADER=
TRQSH_GEOIP_API=

# OPTIONAL JSON override of the edge PoP catalog advertised at /v1/regions. The
# built-in default (eu/us/ap on trqsh.uz) is used when blank. Example:
#   TRQSH_REGIONS=[{"code":"eu","name":"Europe","continent":"EU","country":"DE","endpoint":"eu.trqsh.uz:443","default":true}]
TRQSH_REGIONS=


# --- OAuth (optional; real users sign in with these in production) -----------
# Dev password-less auth is OFF in production, so public sign-up needs OAuth.
# Callback URLs must point at https://api.<domain>/v1/auth/oauth/<provider>/callback.
TRQSH_GITHUB_CLIENT_ID=
TRQSH_GITHUB_CLIENT_SECRET=
TRQSH_GOOGLE_CLIENT_ID=
TRQSH_GOOGLE_CLIENT_SECRET=


# --- Billing / Stripe (optional; all blank = billing disabled) ---------------
# Fill these to sell paid plans. Keys, price IDs, and meter IDs come from the
# Stripe dashboard (use test keys until you go live).
TRQSH_STRIPE_SECRET_KEY=
TRQSH_STRIPE_WEBHOOK_SECRET=
TRQSH_STRIPE_PRICE_PRO_MONTHLY=
TRQSH_STRIPE_PRICE_PRO_ANNUAL=
TRQSH_STRIPE_PRICE_TEAM_MONTHLY=
TRQSH_STRIPE_PRICE_TEAM_ANNUAL=
TRQSH_STRIPE_PRICE_PAYG_METERED=
TRQSH_STRIPE_METER_BANDWIDTH=
TRQSH_STRIPE_METER_REQUESTS=
# OPTIONAL billing tuning (sensible defaults apply when blank):
#   TRQSH_BILLING_TRIAL_DAYS=14
#   TRQSH_BILLING_METERING_INTERVAL=1h
#   TRQSH_BILLING_SUCCESS_URL / _CANCEL_URL / _PORTAL_RETURN_URL  (default to app.<domain>)


# --- Public URLs (optional; default to app./api./qr.<domain>) ----------------
# Override only if your app/api/qr hosts differ from the derived defaults.
#   TRQSH_API_PUBLIC_URL=https://api.trqsh.uz
#   TRQSH_APP_URL=https://app.trqsh.uz
#   TRQSH_QR_URL=https://qr.trqsh.uz


# --- Images / scaling / observability (optional) -----------------------------
# Which GHCR image tag the services run. `latest` = the last TAGGED release; pin
# a specific vX.Y.Z or sha-xxxxxxx for a controlled roll.
TRQSH_IMAGE_TAG=latest

# Set to `apilb` (and start the apilb profile) when running >1 api replica —
# see "Scaling the control API" in PRODUCTION.md. Leave `api` otherwise.
TRQSH_API_TARGET=api

# Grafana admin password (only used with --profile observability; Grafana binds
# to 127.0.0.1, reachable via SSH tunnel). Set a real value anyway.
GRAFANA_ADMIN_PASSWORD=admin
