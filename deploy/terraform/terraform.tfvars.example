# Copy to terraform.tfvars (gitignored) and fill in. Secrets can also be passed
# as TF_VAR_* env vars in CI instead of a file.

# do_token          = "dop_v1_..."          # or export TF_VAR_do_token
# spaces_access_id  = "..."                  # for Spaces buckets + remote state
# spaces_secret_key = "..."
# internal_token    = "a-long-random-shared-edge-api-token"

domain                = "trqsh.uz"
primary_region        = "fra1"
edge_regions          = ["fra1", "nyc3", "sgp1"]
edge_nodes_per_region = 2
acme_email            = "ops@trqsh.uz"

# SSH keys placed on edge droplets (DO fingerprints).
# ssh_key_fingerprints = ["aa:bb:cc:..."]

# Set after `helm install` provisions the ingress LoadBalancer (or use external-dns).
# control_ingress_ip = "203.0.113.10"

# --- Inter-edge forwarding (Stage D) ----------------------------------------
# Edges advertise their "public" interface by default so the forwarding hop works
# ACROSS regions (DO VPCs are single-region). For a SINGLE-region deployment you can
# use the free private hop instead:
# edge_forward_iface = "private"
# edge_forward_port  = 4444

# --- Cloudflare Load Balancing (optional; DNS-only steering) -----------------
# Leave enable_cloudflare_lb = false to keep the DigitalOcean wildcard round-robin.
# Turn it on only with a Cloudflare-hosted zone + a Load Balancing plan (see
# dns_cloudflare.tf for the full activation checklist and the wildcard-hostname
# plan caveat).
# enable_cloudflare_lb  = true
# cloudflare_api_token  = "..."   # or export TF_VAR_cloudflare_api_token
# cloudflare_account_id = "..."
# cloudflare_zone_id    = "..."
# cloudflare_lb_steering_policy = "dynamic_latency"
